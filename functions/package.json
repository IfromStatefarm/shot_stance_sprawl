{
  "name": "snap-and-go-functions",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check": "node --check index.js && node --check subscriptions.js && node --check social.js && node --check team.js && node --check social_helpers.js && node --check app_check.js && node scripts/verify_app_check_config.js",
    "test": "node --test test/social_helpers.test.js test/subscriptions.test.js",
    "test:rules": "firebase emulators:exec --project demo-snap-and-go --only firestore \"node --test test/firestore.rules.test.js\"",
    "test:account": "firebase emulators:exec --project demo-snap-and-go --only auth,firestore,functions,storage \"node --test test/account_data.integration.test.js\"",
    "test:team": "firebase emulators:exec --project demo-snap-and-go --only auth,firestore,functions,storage \"node --test test/team.integration.test.js\"",
    "serve": "firebase emulators:start --only auth,firestore,functions"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.17.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
